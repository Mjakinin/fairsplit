# ===================================================================
# FairSplit - E-Mail Service Konfiguration (.env.local oder Netlify)
# ===================================================================

# OPTION 1: RESEND (Modernster E-Mail Standard - 3.000 Mails/Monat kostenlos)
# Registriere dich kostenlos auf https://resend.com und erstelle einen API-Key:
RESEND_API_KEY=re_123456789abcdef
EMAIL_FROM=FairSplit <onboarding@resend.dev>

# OPTION 2: EIGENES SMTP-POSTFACH (Gmail, IONOS, Strato, Sendinblue, Brevo etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=deine-email@gmail.com
# SMTP_PASS=dein-app-passwort
# EMAIL_FROM=FairSplit <deine-email@gmail.com>

# ===================================================================
# ADMIN MASTER DASHBOARD & DATENBANK PIN (OPTIONAL, STANDARD: admin2026)
# ===================================================================
ADMIN_PASSWORD=deinSicheresAdminPasswort2026

# ===================================================================
# OPTIONAL: SUPABASE (FÜR CLOUD POSTGRESQL & REALTIME SYNC)
# ===================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
