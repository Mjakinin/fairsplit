# ===================================================================
# FairSplit - E-Mail Service Konfiguration (.env.local oder Netlify)
# ===================================================================

# OPTION 1: RESEND (3.000 Mails/Monat kostenlos)
# RESEND_API_KEY=your_resend_api_key_here
# EMAIL_FROM=FairSplit <your-verified-domain-email>

# OPTION 2: EIGENES SMTP-POSTFACH (Gmail, IONOS, Strato, Sendinblue, Brevo etc.)
# SMTP_HOST=your-smtp-host-here
# SMTP_PORT=587
# SMTP_USER=your-smtp-user-here
# SMTP_PASS=your-smtp-password-here
# EMAIL_FROM=FairSplit <your-sender-email>

# ===================================================================
# ADMIN MASTER DASHBOARD (OPTIONAL)
# ===================================================================
# ADMIN_PASSWORD=your-custom-admin-password-here

# ===================================================================
# OPTIONAL: SUPABASE (FÜR CLOUD POSTGRESQL & REALTIME SYNC)
# ===================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
